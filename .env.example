# Copy to server/.env (or export these) before running in anything but local dev.

# --- Core ---
PORT=4000
NODE_ENV=development

# --- Auth ---
# Change this in production: it signs every session token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Restrict staff/admin self-registration to your college's domains.
# Leave blank to allow any email to register as staff (local dev only).
STAFF_EMAIL_DOMAINS=college.edu

# --- Database ---
# Defaults to server/data/hacktrack.db
# DB_FILE=/var/lib/hacktrack/hacktrack.db

# --- AI assistant ---
# Without a key the assistant falls back to a local rule-based answerer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Push notifications (PWA) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hacktrack@college.edu

# --- Deadline reminders ---
# How often the sweep runs, and how many days before the deadline to remind.
REMINDER_INTERVAL_MS=900000
REMINDER_OFFSETS=7,3,1,0
